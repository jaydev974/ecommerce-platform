# Copy this file to .env. Do not commit .env.
DB_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password
# At least 64 random characters. Generate one with: openssl rand -base64 64
JWT_SECRET=replace-with-at-least-64-random-characters-before-deployment

# Optional integrations
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
